# Code-only allowlist. Assets, renders, QA records and other episodes stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSES.md
!/requirements.txt
!/ep01/
!/ep02/
!/ep03/
/ep01/*
/ep02/*
/ep03/*
!/ep01/production/
!/ep02/production/
!/ep03/production/
!/ep02/assets/
!/ep03/assets/
/ep01/production/*
/ep02/production/*
/ep03/production/*
!/ep01/production/*.py
!/ep01/production/story.json
!/ep01/production/timeline.json
!/ep02/production/render.py
!/ep02/production/timeline.json
!/ep03/production/*.py
!/ep03/production/timeline.json
!/ep03/production/imagegen_prompt.txt
!/ep03/production/music_research.md
/ep02/assets/*
/ep03/assets/*
!/ep02/assets/ATTRIBUTION.md
!/ep03/assets/ATTRIBUTION.md
!/ep03/assets/GPT_REFERENCE_SOURCE.md
!/ep03/assets/dragon_regions.json
